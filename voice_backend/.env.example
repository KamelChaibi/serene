# ---------------------------------------------------------------------------
# Serene voice backend — copy to `.env` and edit.
#
#   cp .env.example .env
#
# Nothing here is a paid service.  Every value points at software running on
# your own machine or LAN.
# ---------------------------------------------------------------------------

# --- general ---------------------------------------------------------------
# dev | prod.  In prod the agent keeps LiveKit transcripts out of its logs.
SERENE_ENV=dev
SERENE_LOG_LEVEL=INFO
SERENE_DATA_DIR=./data

# --- device enrolment ------------------------------------------------------
# Optional shared code.  When set, a new install must supply it once.  When
# empty, any device that can reach this API can enrol (still rate limited).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(24))"
SERENE_ENROLLMENT_CODE=
SERENE_MAX_DEVICES=500
SERENE_ENROLL_WINDOW_SECONDS=600
SERENE_ENROLL_MAX_ATTEMPTS=10

# --- LiveKit ---------------------------------------------------------------
# URL the phone uses.  On a LAN this must be the host's LAN address, not
# 127.0.0.1.  For production put LiveKit behind TLS and use wss://.
LIVEKIT_URL=ws://192.168.1.10:7880
# URL the agent container uses.  Leave empty outside Docker.
LIVEKIT_INTERNAL_URL=
LIVEKIT_HTTP_URL=http://livekit:7880
LIVEKIT_API_KEY=devkey
# Replace this placeholder before starting: the API refuses to boot with it,
# and any value shorter than 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
LIVEKIT_API_SECRET=change-me-please-use-a-long-random-string
SERENE_AGENT_NAME=serene-voice
SERENE_TOKEN_TTL_SECONDS=600
SERENE_ROOM_EMPTY_TIMEOUT_SECONDS=60

# --- local model services --------------------------------------------------
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_MODEL=qwen3:4b
OLLAMA_API_KEY=ollama

STT_BASE_URL=http://stt:8001/v1
STT_MODEL=whisper-1

TTS_BASE_URL=http://tts:8002/v1
TTS_MODEL=serene-tts

# --- personality -----------------------------------------------------------
SERENE_PROMPT_FILE=./prompts/serene_friend.yaml
SERENE_LOW_VRAM=true
SERENE_MAX_MEMORIES=20
SERENE_MAX_MEMORY_CHARS=280
SERENE_MAX_NOTES_CHARS=500

# --- speech-to-text --------------------------------------------------------
STT_MODEL_NAME=/models/faster-whisper/medium
STT_DEVICE=auto
STT_COMPUTE_TYPE=auto
STT_BEAM_SIZE=1
STT_CPU_THREADS=0
STT_DOWNLOAD_ROOT=/models/faster-whisper
STT_PRELOAD=true
STT_MAX_UPLOAD_MB=25
STT_MAX_AUDIO_SECONDS=300

# --- text-to-speech --------------------------------------------------------
TTS_DEVICE=auto
TTS_PRELOAD=true
TTS_PRELOAD_SILMA=false
TTS_KOKORO_REPO=hexgrad/Kokoro-82M
TTS_KOKORO_VOICES=af_heart,af_bella,af_nicole,af_sarah,am_michael,am_adam,bf_emma,bm_george,ff_siwis
TTS_MAX_INPUT_CHARS=2000

SERENE_MODELS_DIR=/models
SILMA_MSA_DIR=/models/silma-msa
SILMA_DERJA_DIR=/models/silma-derja
SILMA_NFE_STEP=16
SILMA_CFG_STRENGTH=2.0
SILMA_USE_EMA=false
# NeMo normalisation and the tashkeel model add VRAM and latency.  Enable on
# a larger card if Arabic numbers/dates are read incorrectly.
SILMA_NORMALIZE=false
SILMA_TASHKEEL=false
# Optional native reference clips.  F5-TTS clones the reference timbre, so a
# Derja clip with matching text measurably improves prosody.
SILMA_MSA_REF_AUDIO=
SILMA_MSA_REF_TEXT=
SILMA_DERJA_REF_AUDIO=
SILMA_DERJA_REF_TEXT=

# --- Ollama ----------------------------------------------------------------
# 8 GB card: keep one model resident and unload quickly.
OLLAMA_KEEP_ALIVE=10m
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
