# Serene text-chat proxy configuration.
# Copy this file to backend/.env and fill in your own values.
# Never commit backend/.env.

# Required. Create a key at https://openrouter.ai/keys and keep it on the server.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional. Model used by the proxy.
MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Optional. Port the proxy listens on.
PORT=8787
